# Loaded by `vite build --mode app` (npm run build:app) — the Capacitor Android
# bundle. The web build ignores this file and keeps using the relative
# same-origin path in login.jsx.
#
# The APK has no origin to be relative to, so every API call needs an absolute
# URL. This host must also appear in CORS_ALLOWED_ORIGINS on the backend.
VITE_API_URL=https://brollysolutions.in/login/api/v1/
